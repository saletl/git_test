# The Curious Creature Clinic: FUTURE server settings
#
# Nothing in the current build reads these. Email delivery and the newsletter are deliberately NOT connected:
# the grown-up area shows a preview that sends and saves nothing. Follow docs/EMAIL-INTEGRATION.md before
# using any of these.
#
# When the email function is added, these will be used ONLY on the server and never sent to the browser.
# On Netlify, add them under Site configuration > Environment variables. Never put real values in this file
# or commit a .env file to Git (.gitignore already blocks it).

# ---- Coloring book email delivery --------------------------------------------------------------
# "resend" sends real email through Resend (https://resend.com).
# "mock" sends nothing (for local testing). Leave empty to keep email delivery off.
EMAIL_PROVIDER=

# From Resend > API Keys. Starts with "re_". Give it "Sending access" only.
RESEND_API_KEY=

# The sender. Must use a domain you've verified in Resend, e.g. "The Curious Creature Clinic <clinic@theburrowparenting.com>"
EMAIL_FROM=

# Optional: where replies go, e.g. a monitored Burrow inbox.
EMAIL_REPLY_TO=

# ---- Optional newsletter (MailerLite) ---------------------------------------------------------
# From MailerLite > Integrations > API. Leave both empty to turn the newsletter off.
MAILERLITE_API_KEY=

# The ID of the group "Curious Creature Clinic — Newsletter Opt-ins" (MailerLite > Subscribers > Groups).
MAILERLITE_GROUP_ID=

# "true" (recommended): new sign-ups start as "unconfirmed" until they click MailerLite's confirmation email.
# Also turn on "Double opt-in for API and integrations" in MailerLite so that email is sent.
MAILERLITE_DOUBLE_OPT_IN=true

# ---- Security ----------------------------------------------------------------------------------
# The exact address(es) of your live game, comma separated, with no trailing slash.
# Example: https://clinic.theburrowparenting.com,https://curious-clinic.netlify.app
# If empty, only requests from the same host as the function are accepted.
ALLOWED_ORIGINS=

# Any long random text. Used to scramble (hash) addresses for rate limiting so they aren't kept in plain form.
RATE_LIMIT_SALT=
