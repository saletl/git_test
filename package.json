{
  "name": "curious-creature-clinic",
  "private": true,
  "version": "1.0.0",
  "description": "The Curious Creature Clinic: a tiny, magical doctor's office game for children in pediatric waiting rooms. Created with care by The Burrow Parenting.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:secrets",
    "check:secrets": "node scripts/check-bundle-secrets.mjs",
    "qr": "node scripts/make-qr.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@netlify/functions": "6.0.3",
    "@playwright/test": "1.56.1",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "qrcode": "1.5.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
